# Assets are referenced with ?v=<version> URLs, so they may be cached
# forever; everything dynamic sends Cache-Control: no-store itself.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# The vhost already answers http:// with a 301, but that lives in the host's
# own configuration: this repo does not own it, CI cannot check it, and a
# deploy can neither break nor restore it. So the redirect is ALSO stated
# here, where it is version-controlled. Normally it never runs - the vhost
# rule fires first - and it exists for the day that rule is lost.
#
# 308, not 301: it is the only redirect status a client must not turn into a
# GET, so a redirected POST keeps its body. That does not make http:// safe to
# use - the body has already crossed the network in cleartext by then - which
# is why the API contract tells clients to request https:// directly.
#
# php -S ignores .htaccess entirely, so the smoke suite cannot cover this;
# only real Apache can prove it. Verify on live after the deploy that carries
# it: a plain http:// request still lands on https://, and an https:// request
# is answered normally rather than looping.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=308,L]
</IfModule>

# HSTS: a browser that has loaded the site over HTTPS then upgrades any later
# http:// itself, closing the pre-redirect window the redirect leaves. Non-HSTS
# clients (an old TV) ignore it, so it blocks no one. No includeSubDomains -
# this host only. Apache-only, verified on live.
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# What each request waited for a free PHP-FPM worker, measured where the
# waiting actually happens. Apache stamps the moment it RECEIVED the request
# into a request header, in MICROseconds, and PHP subtracts it from its own
# start time (see Load::queueUs): the difference is the time the request
# spent queued for a worker.
#
# That is the one saturation signal PHP cannot produce for itself. A worker
# count says how close to the pool's ceiling we run; this says whether we hit
# it - and while a request is waiting there is no PHP running to notice.
#
# "set" overwrites, so a client cannot forge its own wait. Same module and
# same AllowOverride class as the Header rules above, which are verified on
# live. An absent header stays ordinary rather than an error: php -S ignores
# .htaccess entirely, so the smoke tests never see this, and Load::queueUs
# answers null and counts nothing.
<IfModule mod_headers.c>
    RequestHeader set X-Request-Start "%t"
</IfModule>

# THE clock source clients sync against (docs/API.md, "Time
# synchronization and PTS"). Apache stamps the moment it RECEIVED the
# request into the header, in MICROseconds, and serves the file without
# PHP - so clock sync never queues for a PHP-FPM worker. That queue wait
# happens before PHP starts, so PHP can neither see nor subtract it, and
# it would land in the client's offset as if it were network delay.
#
# php -S ignores .htaccess entirely, so nothing here is covered by the
# smoke test: only real Apache can prove it works. Verified on live in
# 0.16.3, which is why this shipped alone first.
#
# no-store is not optional: a cached timestamp is a wrong clock. The
# immutable rule above matches on extension and never sees this file, but
# a proxy default might.
#
# Allow-Origin is * rather than the FOK_ALLOWED_ORIGINS allowlist the PHP
# endpoints use: this file bypasses PHP, so it cannot consult that list,
# and it discloses nothing the HTTP Date header does not already.
# Expose-Headers is what lets a browser read X-Fok-T cross-origin at all.
<IfModule mod_headers.c>
    <Files "t.txt">
        Header set X-Fok-T "%t"
        Header set Cache-Control "no-store"
        Header set Access-Control-Allow-Origin "*"
        Header set Access-Control-Expose-Headers "X-Fok-T"
    </Files>
</IfModule>
